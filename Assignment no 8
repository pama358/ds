def dfs(matrix, visited, node):
    print(node, end=" ")
    visited[node] = True

    for i in range(len(matrix)):
        if matrix[node][i] == 1 and not visited[i]:
            dfs(matrix, visited, i)


nodes = ['A', 'B', 'C', 'D', 'E']

adj_matrix = [
    [0, 1, 1, 0, 0],
